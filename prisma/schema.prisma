generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String  @id @default(uuid())
  email           String  @unique
  name            String?
  phone           String?
  authHash        String
  securityToken   String? @unique
  enable2FA       Boolean @default(false)
  twoFactorSecret String?
  recoveryCodes   String  @default("") // csv

  //User's Asymmetric Key Pair for sharing
  publicKey           String
  encryptedPrivateKey String

  createdAt  DateTime     @default(now())
  vaults     Vault[]
  logins     Login[]
  itemAccess ItemAccess[]
}

model Login {
  id        String   @id @default(uuid())
  userId    String
  userAgent String
  ipAddress String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ItemAccess {
  id     String @id @default(cuid())
  userId String
  itemId String

  // The AES key
  encryptedRecordKey String

  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item SecureItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model SecureItem {
  id            String  @id @default(cuid())
  // metadata
  title         String
  category      String
  isCompromised Boolean @default(false)

  // cryptographic fields
  ciphertext String
  iv         String
  tag        String

  // timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastScan  DateTime?

  // relations
  vaultItems VaultSecureItems[]
  accessors  ItemAccess[] // Replaces ownerId
}

model VaultSecureItems {
  vaultId String
  itemId  String
  item    SecureItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vault   Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@id([vaultId, itemId])
}

model Vault {
  id               String   @id @default(cuid())
  ownerId          String
  title            String
  icon             String   @default("default")
  enableMonitoring Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vaultItems VaultSecureItems[]

  @@index([ownerId])
}

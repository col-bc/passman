generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  phone         String?
  authHash      String
  securityToken String?  @unique
  createdAt     DateTime @default(now())
  lockers       Locker[]
  logins        Login[]
}

model Login {
  id        String   @id @default(uuid())
  userId    String
  userAgent String
  ipAddress String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Item {
  id          String        @id @default(cuid())
  ownerId     String
  lockerId    String?
  title       String
  category    String
  ciphertext  Bytes
  iv          Bytes
  tag         Bytes
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lockerItems LockerItems[]

  isCompromised Boolean   @default(false)
  lastScan      DateTime?

  @@index([ownerId])
}

model LockerItems {
  lockerId String
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  locker   Locker @relation(fields: [lockerId], references: [id])

  @@id([lockerId, itemId])
}

model Locker {
  id               String        @id @default(cuid())
  ownerId          String
  title            String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [ownerId], references: [id])
  lockerItems      LockerItems[]
  enableMonitoring Boolean       @default(false)

  @@index([ownerId])
}
